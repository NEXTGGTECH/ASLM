<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('linux'))">linux-x64</RuntimeIdentifier>
		<Platforms>x64;ARM64</Platforms>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
    
		<AssemblyName>ASLM</AssemblyName>
		<Version>0.11.0.19</Version>
		<FileVersion>0.11.0.19</FileVersion>
		<InformationalVersion>0.11.0.19</InformationalVersion>
	</PropertyGroup>
	
	<Import Project="..\..\ASLM.Build.props" />

	<PropertyGroup>
		<!-- Nested test project sources and build artifacts are not part of the launcher. -->
		<DefaultItemExcludes>$(DefaultItemExcludes);Tests\**</DefaultItemExcludes>
		<!-- Building the launcher runs only the launcher's own suite. -->
		<ASLMTestProject>Tests\ASLM.Launcher.Tests.csproj</ASLMTestProject>
	</PropertyGroup>

	<Import Project="..\ASLM.Test.targets" Condition="Exists('..\ASLM.Test.targets')" />

	<PropertyGroup>
		<OutputPath>$(ASLMBuildOutputRoot)</OutputPath>
		<OutputType Condition="'$(ASLMBuildOs)' == 'linux'">Exe</OutputType>
	</PropertyGroup>

	<PropertyGroup Condition="'$(SelfContained)' == 'true'">
		<OutputPath>$(MSBuildProjectDirectory)\obj\$(Configuration)\launcher-sc-build\</OutputPath>
		<PublishSingleFile>true</PublishSingleFile>
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
		<EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
	</PropertyGroup>

	<PropertyGroup>
		<PublishDir Condition="'$(PublishDir)' == ''">$(ASLMBuildOutputRoot)</PublishDir>
	</PropertyGroup>

	<ItemGroup Condition="'$(Configuration)' == 'Debug' and '$(ASLMBuildOs)' != 'linux'">
		<Content Include="..\..\Data\**\*.*">
			<Link>Data\%(RecursiveDir)%(Filename)%(Extension)</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>

		<Content Include="..\..\Engines\**\*.*">
			<Link>Engines\%(RecursiveDir)%(Filename)%(Extension)</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>

		<Content Include="..\..\Models\**\*.*">
			<Link>Models\%(RecursiveDir)%(Filename)%(Extension)</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		
		<Content Include="..\..\Modules\**\*.*">
			<Link>Modules\%(RecursiveDir)%(Filename)%(Extension)</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>
	
	<ItemGroup Condition="'$(Configuration)' == 'Release' and '$(ASLMBuildOs)' != 'linux'">
		<Content Include="..\..\Data\**\*.*">
			<Link>Data\%(RecursiveDir)%(Filename)%(Extension)</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		
		<Content Include="..\..\Engines\**\ASLM_Engine.json">
			<Link>Engines\%(RecursiveDir)%(Filename)%(Extension)</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>

		<Content Include="..\..\Models\**\ASLM_Model.json">
			<Link>Models\%(RecursiveDir)%(Filename)%(Extension)</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>

		<Content Include="..\..\Modules\**\ASLM_Module.json">
			<Link>Modules\%(RecursiveDir)%(Filename)%(Extension)</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>
	
</Project>
