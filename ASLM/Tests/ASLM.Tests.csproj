<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
		<RootNamespace>ASLM.Tests</RootNamespace>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>

		<ASLMTestLayoutRoot>$(MSBuildProjectDirectory)\_layout_root\</ASLMTestLayoutRoot>
		<!-- Generated test layouts are not project inputs; stale DLLs there must not override HintPath references. -->
		<DefaultItemExcludes>$(DefaultItemExcludes);$(ASLMTestLayoutRoot)**</DefaultItemExcludes>
		<OutputPath>$(ASLMTestLayoutRoot)App\</OutputPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

		<UseMaui>false</UseMaui>
		<EnableDefaultMauiItems>false</EnableDefaultMauiItems>

		<ASLMRepoRoot>$(MSBuildThisFileDirectory)..\..\</ASLMRepoRoot>
		<ASLMAppOutputDir>$(ASLMRepoRoot)Build\$(Configuration)\ASLM-windows-amd64\App\</ASLMAppOutputDir>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="coverlet.collector" Version="6.0.4">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="FluentAssertions" Version="8.8.0" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.41" />
		<PackageReference Include="Moq" Version="4.20.72" />
		<PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
		<PackageReference Include="xunit" Version="2.9.3" />
		<PackageReference Include="xunit.runner.visualstudio" Version="3.1.4">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<Reference Include="ASLM">
			<HintPath>$(ASLMAppOutputDir)ASLM.dll</HintPath>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<Using Include="Xunit" />
	</ItemGroup>

	<Target Name="CleanTestLayout" BeforeTargets="BuildAslmApp">
		<RemoveDir Directories="$(OutputPath)" />
	</Target>

	<Target Name="BuildAslmApp" BeforeTargets="BeforeBuild">
		<MSBuild Projects="$(MSBuildThisFileDirectory)..\ASLM.csproj"
		         Targets="Build"
		         Properties="Configuration=$(Configuration);SkipUnitTestsOnBuild=true;SelfContained=false" />
	</Target>

	<!-- The self-update contract test drives the real patcher executable. -->
	<Target Name="BuildPatcherCli" BeforeTargets="BeforeBuild" Condition="'$(ASLMBuildPatcherCli)' != 'false'">
		<MSBuild Projects="$(MSBuildThisFileDirectory)..\Patcher\Patcher-CLI\ASLM.Patcher.CLI.csproj"
		         Targets="Build"
		         Properties="Configuration=$(Configuration);SkipUnitTestsOnBuild=true" />
	</Target>

	<Target Name="CopyAslmRuntime" AfterTargets="Build">
		<!-- Self-contained app builds (e.g. after building the installer bootstrapper) leave the
		     .NET host in the app output. Copying hostfxr/hostpolicy/coreclr next to testhost.exe
		     hijacks the test host's runtime resolution and aborts every test run. -->
		<ItemGroup>
			<_AslmRuntime Include="$(ASLMAppOutputDir)*.dll"
			              Exclude="$(ASLMAppOutputDir)hostfxr.dll;$(ASLMAppOutputDir)hostpolicy.dll;$(ASLMAppOutputDir)coreclr.dll;$(ASLMAppOutputDir)clrjit.dll" />
		</ItemGroup>
		<Copy SourceFiles="@(_AslmRuntime)"
		      DestinationFolder="$(OutputPath)"
		      SkipUnchangedFiles="true" />
	</Target>

</Project>
