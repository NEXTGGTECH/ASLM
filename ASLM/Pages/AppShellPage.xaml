<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dialogs="clr-namespace:ASLM.Controls.Dialogs"
             xmlns:models="clr-namespace:ASLM.Models"
             x:Class="ASLM.Pages.AppShellPage"
             Title="ASLM"
             BackgroundColor="{DynamicResource BackgroundPrimary}">

    <ContentPage.Resources>
        <DataTemplate x:Key="NotificationToastTemplate" x:DataType="models:AppNotification">
            <Border x:Name="ToastCard"
                    BackgroundColor="{DynamicResource BackgroundSecondary}"
                    Stroke="{DynamicResource Separator}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 10"
                    Padding="10"
                    InputTransparent="False">
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.35" Radius="12" Offset="0,4" />
                </Border.Shadow>

                <Grid ColumnDefinitions="4,*,Auto"
                      ColumnSpacing="8">
                    <BoxView BackgroundColor="{Binding AccentColor}"
                             WidthRequest="4"
                             VerticalOptions="Fill" />

                    <VerticalStackLayout Grid.Column="1"
                                         Spacing="8">
                        <VerticalStackLayout Spacing="4">
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer CommandParameter="{x:Reference ToastCard}"
                                                      Tapped="OnToastBodyTapped" />
                            </VerticalStackLayout.GestureRecognizers>

                            <Label Text="{Binding CardTitle}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource LabelPrimary}"
                                   MaxLines="2"
                                   LineBreakMode="CharacterWrap" />

                            <Label Text="{Binding CardStatusText}"
                                   IsVisible="{Binding HasCardStatus}"
                                   FontSize="12"
                                   TextColor="{DynamicResource LabelPrimary}"
                                   MaxLines="1"
                                   LineBreakMode="TailTruncation" />

                            <Grid ColumnDefinitions="*,Auto,Auto"
                                  ColumnSpacing="8"
                                  IsVisible="{Binding HasDetailText}">
                                <Label Text="{Binding DetailText}"
                                       FontSize="11"
                                       TextColor="{DynamicResource LabelPrimary}"
                                       MaxLines="1"
                                       LineBreakMode="TailTruncation" />
                                <Label Grid.Column="1"
                                       Text="{Binding TransferSpeedDisplay}"
                                       IsVisible="{Binding ShowDownloadMetricsRow}"
                                       FontSize="11"
                                       TextColor="{DynamicResource LabelPrimary}"
                                       MaxLines="1" />
                                <Label Grid.Column="2"
                                       Text="{Binding TransferPercentDisplay}"
                                       IsVisible="{Binding ShowDownloadMetricsRow}"
                                       FontSize="11"
                                       TextColor="{DynamicResource LabelPrimary}"
                                       MaxLines="1" />
                            </Grid>

                            <ProgressBar Progress="{Binding ProgressFraction}"
                                         IsVisible="{Binding HasProgress}"
                                         ProgressColor="{DynamicResource ActionBlue}" />

                            <Label Text="{Binding TimestampLabel}"
                                   FontSize="11"
                                   TextColor="{DynamicResource LabelSecondary}" />
                        </VerticalStackLayout>

                        <HorizontalStackLayout Spacing="8"
                                               IsVisible="{Binding OffersUpdateActions}">
                            <Button Text="{Binding UpdateNowText}"
                                    FontSize="11"
                                    HeightRequest="28"
                                    MinimumHeightRequest="28"
                                    Padding="10,0"
                                    Margin="0"
                                    BackgroundColor="{DynamicResource ActionBlue}"
                                    TextColor="{DynamicResource White}"
                                    CornerRadius="6"
                                    Clicked="OnToastUpdateNowClicked" />
                            <Button Text="{Binding UpdateLaterText}"
                                    IsVisible="{Binding CanDeferUpdate}"
                                    FontSize="11"
                                    HeightRequest="28"
                                    MinimumHeightRequest="28"
                                    Padding="10,0"
                                    Margin="0"
                                    BackgroundColor="{DynamicResource BackgroundTertiary}"
                                    TextColor="{DynamicResource LabelPrimary}"
                                    CornerRadius="6"
                                    Clicked="OnToastUpdateLaterClicked" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <Button Grid.Column="2"
                            Text="&#x2715;"
                            FontSize="14"
                            WidthRequest="24"
                            MinimumWidthRequest="24"
                            HeightRequest="24"
                            MinimumHeightRequest="24"
                            Padding="0"
                            Margin="0"
                            BackgroundColor="Transparent"
                            TextColor="{DynamicResource LabelSecondary}"
                            CornerRadius="4"
                            HorizontalOptions="End"
                            VerticalOptions="Start"
                            CommandParameter="{x:Reference ToastCard}"
                            Clicked="OnToastCloseClicked" />
                </Grid>
            </Border>
        </DataTemplate>
    </ContentPage.Resources>

    <Grid>
    <Grid x:Name="ShellSurface" ColumnDefinitions="Auto, *">

        <!-- Left Sidebar -->
        <Grid x:Name="SidePanel" Grid.Column="0"
              RowDefinitions="Auto, *, Auto, Auto"
              BackgroundColor="{DynamicResource BackgroundSecondary}"
              Padding="8">

            <!-- Collapse Toggle (fixed top) -->
            <Button x:Name="CollapseButton"
                    Grid.Row="0"
                    Style="{StaticResource SidebarButton}"
                    TextColor="{DynamicResource LabelSecondary}"
                    HeightRequest="36"
                    HorizontalOptions="Fill"
                    Clicked="OnCollapseClicked" />

            <!-- Scrollable nav list: Module Pages (top section) -->
            <ScrollView Grid.Row="1" Margin="0,4,0,0">
                <VerticalStackLayout x:Name="ModulePagePanel" Spacing="2" />
            </ScrollView>

            <!-- Separator -->
            <BoxView Grid.Row="2"
                     HeightRequest="1"
                     Color="{DynamicResource Separator}"
                     Margin="0,4,0,4" />

            <!-- Bottom section: system pages -->
            <VerticalStackLayout Grid.Row="3" Spacing="2">
                <Button x:Name="HomeButton"
                        Style="{StaticResource SidebarButton}"
                        Text="Home"
                        HeightRequest="36"
                        HorizontalOptions="Fill"
                        Clicked="OnNavClicked" />

                <Button x:Name="ModulesButton"
                        Style="{StaticResource SidebarButton}"
                        Text="Modules"
                        HeightRequest="36"
                        HorizontalOptions="Fill"
                        Clicked="OnNavClicked" />

                <Button x:Name="ConsolesButton"
                        Style="{StaticResource SidebarButton}"
                        Text="Consoles"
                        HeightRequest="36"
                        HorizontalOptions="Fill"
                        Clicked="OnNavClicked" />

                <Button x:Name="AslmApiButton"
                        Style="{StaticResource SidebarButton}"
                        Text="ASLM API"
                        HeightRequest="36"
                        HorizontalOptions="Fill"
                        Clicked="OnNavClicked" />

                <Button x:Name="NotificationsButton"
                        Style="{StaticResource SidebarButton}"
                        Text="Notifications"
                        HeightRequest="36"
                        HorizontalOptions="Fill"
                        Clicked="OnNavClicked" />

                <Button x:Name="DownloadsButton"
                        Style="{StaticResource SidebarButton}"
                        Text="Downloads"
                        HeightRequest="36"
                        HorizontalOptions="Fill"
                        Clicked="OnNavClicked" />

                <Button x:Name="SettingsButton"
                        Style="{StaticResource SidebarButton}"
                        Text="Settings"
                        HeightRequest="36"
                        HorizontalOptions="Fill"
                        Clicked="OnNavClicked" />
            </VerticalStackLayout>
        </Grid>

        <BoxView Grid.Column="0"
                 HorizontalOptions="End"
                 WidthRequest="1"
                 Color="{DynamicResource Separator}"
                 Opacity="0.5"/>

        <!-- Main Content Area -->
        <Grid Grid.Column="1">
            <ContentView x:Name="ContentArea"
                         Padding="8"/>

            <!-- WebView (visible when a module page is selected) -->
            <WebView x:Name="Browser"
                     FlowDirection="LeftToRight"
                     IsVisible="False"
                     HandlerChanged="Browser_HandlerChanged"
                     Navigating="Browser_Navigating"
                     Navigated="Browser_Navigated" />

            <!-- ASLM owns the startup message while the module page is unavailable. -->
            <Grid x:Name="ModuleStarting"
                  IsVisible="False"
                  BackgroundColor="{DynamicResource BackgroundPrimary}">
                <Label x:Name="ModuleStartingText"
                       Margin="8"
                       VerticalOptions="Start"
                       TextColor="{DynamicResource LabelPrimary}" />
            </Grid>
        </Grid>
        
        <!-- Prepared settings stay mounted so opening them reuses native editor controls. -->
        <ContentView x:Name="SettingsHost"
                     Grid.ColumnSpan="2"
                     Opacity="0"
                     IsEnabled="False"
                     InputTransparent="True"
                     AutomationProperties.ExcludedWithChildren="True" />

        <!-- Overlay Container -->
        <ContentView x:Name="OverlayContainer"
                     Grid.ColumnSpan="2"
                     IsVisible="False"
                     BackgroundColor="Transparent" />

        <!-- Toasts sit above the shell: outer layer passes pointer through to WebView2 for drag/drop; only the bottom-right stack captures input. -->
        <Grid Grid.ColumnSpan="2"
              RowDefinitions="*,Auto"
              HorizontalOptions="Fill"
              VerticalOptions="Fill"
              InputTransparent="True"
              CascadeInputTransparent="False">
            <Grid Grid.Row="1"
                  Margin="0,0,16,16"
                  HorizontalOptions="End"
                  VerticalOptions="End"
                  WidthRequest="360"
                  InputTransparent="False">
                <VerticalStackLayout x:Name="ToastPanel"
                                     Spacing="8"
                                     WidthRequest="360"
                                     HorizontalOptions="End"
                                     VerticalOptions="End"
                                     InputTransparent="False" />
            </Grid>
        </Grid>

    </Grid>

        <dialogs:DialogHostView x:Name="Dialogs" />
    </Grid>
</ContentPage>
