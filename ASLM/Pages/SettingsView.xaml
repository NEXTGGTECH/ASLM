<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:settings="clr-namespace:ASLM.Controls.Settings"
             x:Class="ASLM.Pages.SettingsView"
             BackgroundColor="{DynamicResource OverlayBackground}">

    <ContentView.GestureRecognizers>
        <TapGestureRecognizer Tapped="OnBackgroundTapped" />
    </ContentView.GestureRecognizers>

    <Border x:Name="SettingsDialog"
            WidthRequest="1024"
            HeightRequest="576"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            Style="{StaticResource SettingsDialogBorderStyle}">

        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnBorderTapped" />
        </Border.GestureRecognizers>

        <Grid ColumnDefinitions="220,*" ColumnSpacing="0">

            <Border Grid.Column="0"
                    Style="{StaticResource SettingsSidebarBorderStyle}">
                <Grid RowDefinitions="24,*"
                      RowSpacing="12">
                    <Label x:Name="SettingsSidebarTitleLabel"
                           Text="Settings"
                           Style="{StaticResource SettingsDialogTitleLabelStyle}" />

                    <ScrollView x:Name="CategoryScroll"
                                Grid.Row="1"
                                Margin="0,4,0,0"
                                VerticalScrollBarVisibility="Never">
                        <settings:SettingsCategorySelectorView x:Name="CategorySelector" />
                    </ScrollView>
                </Grid>
            </Border>

            <BoxView Grid.Column="0"
                     HorizontalOptions="End"
                     WidthRequest="1"
                     Color="{DynamicResource Separator}"
                     Opacity="0.5" />

            <Grid Grid.Column="1"
                  RowDefinitions="Auto,*,Auto"
                  RowSpacing="0"
                  Margin="0"
                  Padding="12"
                  BackgroundColor="{DynamicResource BackgroundPrimary}">

                <Grid Grid.Row="0"
                      ColumnDefinitions="*,Auto"
                      Margin="0,0,0,12"
                      Padding="0"
                      HeightRequest="24">
                    <Label x:Name="ActiveCategoryTitleLabel"
                           Text=""
                           Style="{StaticResource SettingsDialogTitleLabelStyle}"
                           VerticalOptions="Start" />

                    <Button x:Name="CloseSettingsButton"
                            Grid.Column="1"
                            Text="&#x2715;"
                            FontSize="17"
                            WidthRequest="24"
                            MinimumWidthRequest="24"
                            HeightRequest="24"
                            MinimumHeightRequest="24"
                            Padding="0"
                            Margin="0"
                            ToolTipProperties.Text="Close Settings"
                            BackgroundColor="Transparent"
                            TextColor="{DynamicResource LabelSecondary}"
                            CornerRadius="5"
                            VerticalOptions="Start"
                            Clicked="OnCloseClicked" />
                </Grid>

                <ScrollView Grid.Row="1"
                            x:Name="SettingsScroll"
                            Margin="0,4,0,0"
                            Orientation="Vertical"
                            HorizontalOptions="Fill"
                            VerticalScrollBarVisibility="Never"
                            HorizontalScrollBarVisibility="Never">
                    <VerticalStackLayout x:Name="SettingsContentContainer"
                                         Spacing="16"
                                         Padding="0"
                                         MinimumWidthRequest="0"
                                         HorizontalOptions="Fill"
                                         WidthRequest="{Binding Width, Source={x:Reference SettingsScroll}, x:DataType={x:Type ScrollView}}">

                        <settings:BuiltInSettingsView x:Name="BuiltInSettingsContainer"
                                                      IsVisible="False" />

                        <ContentView x:Name="ModuleSettingsContainer"
                                     MinimumWidthRequest="0"
                                     HorizontalOptions="Fill"
                                     IsVisible="False" />

                        <VerticalStackLayout x:Name="EmptyCategoryState"
                                             IsVisible="False"
                                             Padding="0">
                            <Label x:Name="EmptyCategoryLabel"
                                   Text="This category has no settings."
                                   FontSize="13"
                                   TextColor="{DynamicResource LabelSecondary}" />
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </ScrollView>

                <Grid Grid.Row="2"
                      RowDefinitions="Auto,Auto"
                      Margin="0,8,0,0">
                    <BoxView HeightRequest="1"
                             Color="{DynamicResource Separator}"/>

                    <Grid Grid.Row="1"
                          ColumnDefinitions="*,*"
                          ColumnSpacing="0"
                          Margin="0,12,0,0">
                        <FlexLayout Direction="Row"
                                    Wrap="Wrap"
                                    AlignItems="Start">
                            <Button x:Name="DefaultButton"
                                    Text="Load default"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource SettingsFooterButtonStyle}"
                                    IsVisible="False"
                                    Clicked="OnDefaultClicked" />

                            <Button x:Name="DiscardButton"
                                    Text="Discard Changes"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource SettingsFooterDangerButtonStyle}"
                                    IsVisible="False"
                                    Clicked="OnDiscardChangesClicked" />
                        </FlexLayout>

                        <FlexLayout Grid.Column="1"
                                    Direction="Row"
                                    Wrap="Wrap"
                                    JustifyContent="End"
                                    AlignItems="Start">
                            <Button x:Name="SaveButton"
                                    Text="Save"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource SettingsFooterButtonStyle}"
                                    IsVisible="False"
                                    Clicked="OnSaveClicked" />

                            <Button x:Name="SaveAndRestartButton"
                                    Text="Save and restart"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource SettingsFooterPrimaryButtonStyle}"
                                    IsVisible="False"
                                    Clicked="OnSaveAndRestartClicked" />
                        </FlexLayout>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>

</ContentView>
