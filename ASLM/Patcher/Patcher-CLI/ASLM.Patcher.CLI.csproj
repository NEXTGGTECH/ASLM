<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>ASLM.Patcher</RootNamespace>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Headless patcher helper shipped inside the macOS bundle (Contents/Helpers). -->
		<AssemblyName>aslm-patcher</AssemblyName>
		<InvariantGlobalization>true</InvariantGlobalization>
		<Version>0.11.0.11</Version>
		<FileVersion>0.11.0.11</FileVersion>
		<InformationalVersion>0.11.0.11</InformationalVersion>
	</PropertyGroup>

	<PropertyGroup Condition="'$(SelfContained)' == 'true'">
		<PublishSingleFile>true</PublishSingleFile>
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
		<EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="..\Patcher\Program.cs" Link="PatcherRunner.cs" />
		<InternalsVisibleTo Include="ASLM.Patcher.Tests" />
	</ItemGroup>

	<!-- Building the patcher runs only the patcher's own suite. -->
	<PropertyGroup>
		<ASLMTestProject>..\Tests\ASLM.Patcher.Tests.csproj</ASLMTestProject>
	</PropertyGroup>
	<Import Project="..\..\ASLM.Test.targets" Condition="Exists('..\..\ASLM.Test.targets')" />

</Project>
