<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ASLM.Controls.Modules.ModuleUninstallConfirmationView"
             IsVisible="False">
    <Grid>
        <Grid BackgroundColor="{DynamicResource OverlayBackground}">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnCancelClicked" />
            </Grid.GestureRecognizers>
        </Grid>
        <Border x:Name="DialogBorder"
                Background="{DynamicResource BackgroundPrimary}"
                Stroke="{DynamicResource Separator}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 10"
                Padding="12"
                HorizontalOptions="Center"
                VerticalOptions="Center">
            <Grid RowDefinitions="Auto,Auto,Auto"
                  RowSpacing="16">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="12">
                    <Label x:Name="TitleLabel"
                           Style="{StaticResource DownloadsColumnTitleLabelStyle}"
                           VerticalOptions="Center" />
                    <Button Grid.Column="1"
                            Text="&#x2715;"
                            FontSize="17"
                            WidthRequest="24"
                            MinimumWidthRequest="24"
                            HeightRequest="24"
                            MinimumHeightRequest="24"
                            HorizontalOptions="End"
                            VerticalOptions="Start"
                            Padding="0"
                            BackgroundColor="Transparent"
                            TextColor="{DynamicResource LabelSecondary}"
                            CornerRadius="6"
                            Clicked="OnCancelClicked" />
                </Grid>
                <ScrollView Grid.Row="1"
                            MaximumHeightRequest="360">
                    <Label x:Name="MessageLabel"
                           FontSize="14"
                           TextColor="{DynamicResource LabelPrimary}"
                           LineBreakMode="WordWrap" />
                </ScrollView>
                <HorizontalStackLayout Grid.Row="2"
                                       Spacing="8"
                                       HorizontalOptions="End">
                    <Button x:Name="UninstallButton"
                            Style="{StaticResource SettingsFooterDangerButtonStyle}"
                            Clicked="OnConfirmClicked" />
                    <Button x:Name="OkButton"
                            Style="{StaticResource SettingsFooterPrimaryButtonStyle}"
                            Clicked="OnConfirmClicked" />
                </HorizontalStackLayout>
            </Grid>
        </Border>
    </Grid>
</ContentView>
