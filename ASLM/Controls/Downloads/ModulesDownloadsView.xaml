<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:settings="clr-namespace:ASLM.Controls.Settings"
             xmlns:controls="clr-namespace:ASLM.Controls"
             xmlns:modules="clr-namespace:ASLM.Controls.Modules"
             x:Class="ASLM.Controls.Downloads.ModulesDownloadsView"
             x:Name="RootView"
             BackgroundColor="{DynamicResource BackgroundPrimary}">
    <Grid BindingContext="{x:Reference RootView}"
          RowDefinitions="Auto,Auto,*"
          RowSpacing="8"
          Padding="12">
        <Label x:Name="TitleLabel"
               FontSize="18"
               FontAttributes="Bold"
               TextColor="{DynamicResource LabelPrimary}"
               Margin="0,0,36,0" />
        <Border Grid.Row="1"
                Background="{DynamicResource BackgroundSecondary}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 6"
                Padding="8,0"
                Margin="0,4,0,0">
            <Entry x:Name="SearchEntry"
                   Style="{StaticResource SettingsTextEntryStyle}"
                   settings:SettingsControlChrome.FlatEntry="True"
                   ClearButtonVisibility="WhileEditing"
                   HeightRequest="34"
                   MinimumHeightRequest="34"
                   FontSize="13"
                   TextChanged="OnSearchTextChanged"
                   BackgroundColor="Transparent"
                   TextColor="{DynamicResource LabelPrimary}"
                   PlaceholderColor="{DynamicResource LabelSecondary}" />
        </Border>
        <Grid Grid.Row="2"
              ColumnDefinitions="*,Auto">
            <ScrollView x:Name="ModulesScroll"
                        VerticalScrollBarVisibility="Never"
                        HorizontalScrollBarVisibility="Never">
                <VerticalStackLayout Spacing="8"
                                     BindableLayout.ItemsSource="{Binding Modules}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <modules:ModuleCatalogCardView ModuleSelected="OnModuleSelected" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </ScrollView>
            <controls:AppScrollBar Grid.Column="1"
                                   Target="{x:Reference ModulesScroll}" />
            <Label x:Name="EmptyLabel"
                   FontSize="14"
                   TextColor="{DynamicResource LabelSecondary}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
        </Grid>
    </Grid>
</ContentView>
