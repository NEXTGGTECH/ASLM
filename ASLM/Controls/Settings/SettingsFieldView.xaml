<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:settings="clr-namespace:ASLM.Controls.Settings"
             x:Class="ASLM.Controls.Settings.SettingsFieldView"
             x:DataType="settings:SettingsFieldView"
             x:Name="Root">
    <Border Style="{StaticResource SettingsFieldBorderStyle}"
            MinimumWidthRequest="0"
            HorizontalOptions="Fill"
            Padding="{Binding FieldPadding, Source={x:Reference Root}}">
        <ContentView Content="{Binding FieldContent, Source={x:Reference Root}}"
                     MinimumWidthRequest="0"
                     HorizontalOptions="Fill" />
    </Border>
</ContentView>
