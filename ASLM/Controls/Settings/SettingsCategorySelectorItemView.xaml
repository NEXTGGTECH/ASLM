<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:presentation="clr-namespace:ASLM.Services.Internal"
             x:Class="ASLM.Controls.Settings.SettingsCategorySelectorItemView"
             x:DataType="presentation:SettingsCategorySelectorItemViewModel">
    <Border Style="{StaticResource SettingsSelectorButtonBorderStyle}">
        <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding SelectCommand}" />
        </Border.GestureRecognizers>
        <Border.Triggers>
            <DataTrigger TargetType="Border"
                         Binding="{Binding IsActive}"
                         Value="True">
                <Setter Property="BackgroundColor"
                        Value="{DynamicResource BackgroundTertiary}" />
            </DataTrigger>
        </Border.Triggers>
        <Label Text="{Binding Title}"
               Style="{StaticResource SettingsSelectorButtonLabelStyle}">
            <Label.Triggers>
                <DataTrigger TargetType="Label"
                             Binding="{Binding IsActive}"
                             Value="True">
                    <Setter Property="TextColor"
                            Value="{DynamicResource LabelPrimary}" />
                </DataTrigger>
            </Label.Triggers>
        </Label>
    </Border>
</ContentView>
