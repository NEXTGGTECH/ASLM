<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:settings="clr-namespace:ASLM.Controls.Settings"
             x:Class="ASLM.Controls.Settings.SettingsRowView"
             x:DataType="settings:SettingsRowView"
             x:Name="Root">
    <Border Style="{StaticResource SettingsCardBorderStyle}">
        <Grid ColumnDefinitions="*,Auto"
              ColumnSpacing="8"
              MinimumWidthRequest="0"
              HorizontalOptions="Fill"
              MinimumHeightRequest="32">
            <Grid ColumnDefinitions="Auto,Auto,*"
                  ColumnSpacing="6"
                  MinimumWidthRequest="0"
                  HorizontalOptions="Fill"
                  VerticalOptions="Center">
                <Label Text="{Binding Title, Source={x:Reference Root}}"
                       Style="{StaticResource SettingsCardTitleLabelStyle}" />
                <settings:SettingsInfoButton Description="{Binding Description, Source={x:Reference Root}}"
                                             Grid.Column="1" />
            </Grid>

            <ContentView Grid.Column="1"
                         Content="{Binding TrailingContent, Source={x:Reference Root}}"
                         MinimumWidthRequest="0"
                         HorizontalOptions="End"
                         VerticalOptions="Center" />
        </Grid>
    </Border>
</ContentView>
