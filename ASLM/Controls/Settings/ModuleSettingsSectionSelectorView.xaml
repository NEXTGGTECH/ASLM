<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:presentation="clr-namespace:ASLM.Services.Internal"
             x:Class="ASLM.Controls.Settings.ModuleSettingsSectionSelectorView"
             x:DataType="presentation:ModuleSettingsPageViewModel"
             MinimumWidthRequest="0"
             HorizontalOptions="Fill">
    <ScrollView Orientation="Vertical"
                VerticalScrollBarVisibility="Never"
                HorizontalScrollBarVisibility="Never">
        <VerticalStackLayout Spacing="1"
                             BindableLayout.ItemsSource="{Binding Sections}">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="presentation:ModuleSettingsSectionViewModel">
                    <Border IsVisible="{Binding IsVisible}"
                            Style="{StaticResource SettingsSelectorButtonBorderStyle}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectCommand}" />
                        </Border.GestureRecognizers>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border"
                                         Binding="{Binding IsActive}"
                                         Value="True">
                                <Setter Property="BackgroundColor"
                                        Value="{DynamicResource BackgroundSecondary}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Label Text="{Binding NavigationTitle}"
                               Style="{StaticResource SettingsModuleSectionSelectorButtonLabelStyle}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label"
                                             Binding="{Binding IsActive}"
                                             Value="True">
                                    <Setter Property="TextColor"
                                            Value="{DynamicResource LabelPrimary}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Border>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </VerticalStackLayout>
    </ScrollView>
</ContentView>
