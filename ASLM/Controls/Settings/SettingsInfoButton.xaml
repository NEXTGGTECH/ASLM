<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:settings="clr-namespace:ASLM.Controls.Settings"
             x:Class="ASLM.Controls.Settings.SettingsInfoButton"
             x:DataType="settings:SettingsInfoButton"
             x:Name="Root"
             WidthRequest="18"
             HeightRequest="18"
             MinimumWidthRequest="18"
             MinimumHeightRequest="18"
             IsVisible="{Binding HasDescription, Source={x:Reference Root}}">
    <ImageButton x:Name="InfoIconButton"
                 Style="{StaticResource SettingsInfoButtonStyle}"
                 SemanticProperties.Description="{Binding Description, Source={x:Reference Root}}" />
</ContentView>
