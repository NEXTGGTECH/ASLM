<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Overlay shell -->
    <Style x:Key="SettingsDialogBorderStyle" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource BackgroundSecondary}" />
        <Setter Property="Stroke" Value="{DynamicResource Separator}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 8" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="SettingsSidebarBorderStyle" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource BackgroundSecondary}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 0" />
        <Setter Property="Margin" Value="12" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="SettingsDialogTitleLabelStyle" TargetType="Label">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource LabelPrimary}" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="MinimumWidthRequest" Value="0" />
    </Style>

    <!-- Footer actions -->
    <Style x:Key="SettingsFooterButtonStyle" TargetType="Button">
        <Setter Property="TextColor" Value="{DynamicResource LabelSecondary}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource BackgroundTertiary}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="MinimumHeightRequest" Value="32" />
        <Setter Property="MinimumWidthRequest" Value="0" />
        <Setter Property="MaximumWidthRequest" Value="220" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
        <Setter Property="Opacity" Value="1" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Pressed" />
                    <VisualState x:Name="PointerOver" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{DynamicResource LabelTertiary}" />
                            <Setter Property="BackgroundColor" Value="{DynamicResource BackgroundTertiary}" />
                            <Setter Property="Opacity" Value="0.65" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="SettingsFooterPrimaryButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource SettingsFooterButtonStyle}">
        <Setter Property="TextColor" Value="{DynamicResource White}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ActionBlue}" />
    </Style>

    <Style x:Key="SettingsFooterDangerButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource SettingsFooterButtonStyle}">
        <Setter Property="TextColor" Value="{DynamicResource White}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ActionRed}" />
    </Style>

    <!-- Category selector -->
    <Style x:Key="SettingsSelectorHeaderLabelStyle" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource SystemGray}" />
        <Setter Property="Margin" Value="4,0,0,0" />
    </Style>

    <Style x:Key="SettingsSelectorButtonBorderStyle" TargetType="Border">
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        <Setter Property="MinimumHeightRequest" Value="32" />
        <Setter Property="HeightRequest" Value="32" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="HorizontalOptions" Value="Fill" />
    </Style>

    <Style x:Key="SettingsSelectorButtonLabelStyle" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{DynamicResource LabelSecondary}" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HorizontalOptions" Value="Start" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
    </Style>

    <!-- Sections and cards -->
    <Style x:Key="SettingsTransparentBorderStyle" TargetType="Border">
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <Style x:Key="SettingsSectionBorderStyle"
           TargetType="Border"
           BasedOn="{StaticResource SettingsTransparentBorderStyle}">
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="MinimumWidthRequest" Value="0" />
    </Style>

    <Style x:Key="SettingsCardBorderStyle"
           TargetType="Border"
           BasedOn="{StaticResource SettingsTransparentBorderStyle}">
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="MinimumWidthRequest" Value="0" />
    </Style>

    <Style x:Key="SettingsSubGroupHeaderLabelStyle" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource LabelTertiary}" />
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="MinimumWidthRequest" Value="0" />
    </Style>

    <Style x:Key="SettingsCardTitleLabelStyle" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource LabelPrimary}" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="MinimumWidthRequest" Value="0" />
    </Style>

    <Style x:Key="SettingsCardDescriptionLabelStyle" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{DynamicResource LabelSecondary}" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="MinimumWidthRequest" Value="0" />
    </Style>

    <Style x:Key="SettingsSecondaryLabelStyle" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{DynamicResource LabelSecondary}" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="MinimumWidthRequest" Value="0" />
    </Style>

    <!-- Input shells -->
    <Style x:Key="SettingsFieldBorderStyle" TargetType="Border">
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 6" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="MinimumHeightRequest" Value="36" />
        <Setter Property="BackgroundColor" Value="{DynamicResource BackgroundTertiary}" />
        <Setter Property="Stroke" Value="{DynamicResource Separator}" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="MinimumWidthRequest" Value="0" />
    </Style>

    <Style x:Key="SettingsTextEntryStyle" TargetType="Entry">
        <Setter Property="TextColor" Value="{DynamicResource LabelPrimary}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HeightRequest" Value="36" />
        <Setter Property="MinimumHeightRequest" Value="36" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="MinimumWidthRequest" Value="0" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="SettingsPickerStyle" TargetType="Picker">
        <Setter Property="TextColor" Value="{DynamicResource LabelPrimary}" />
        <Setter Property="TitleColor" Value="{DynamicResource LabelSecondary}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HeightRequest" Value="28" />
        <Setter Property="MinimumHeightRequest" Value="32" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="MinimumWidthRequest" Value="0" />
    </Style>

    <Style x:Key="SettingsInlineActionButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource SettingsFooterPrimaryButtonStyle}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinimumHeightRequest" Value="36" />
        <Setter Property="MaximumWidthRequest" Value="180" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="HorizontalOptions" Value="Start" />
    </Style>

    <Style x:Key="SettingsInlineDangerActionButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource SettingsInlineActionButtonStyle}">
        <Setter Property="BackgroundColor" Value="{DynamicResource ActionRed}" />
    </Style>

    <Style x:Key="SettingsPasswordToggleImageStyle" TargetType="Image">
        <Setter Property="WidthRequest" Value="18" />
        <Setter Property="HeightRequest" Value="18" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="Aspect" Value="AspectFit" />
    </Style>

</ResourceDictionary>
